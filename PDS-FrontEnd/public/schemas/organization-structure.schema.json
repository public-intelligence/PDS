{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pds.gob.do/schemas/organization-structure.schema.json",
  "title": "OrganizationStructureTemplate",
  "description": "Plantilla portable para importar/exportar una estructura organizacional. Solo describe la jerarquía (nombre + tipo de área + dependencias anidadas); el sistema regenera los códigos e identificadores al importar.",
  "type": "object",
  "required": ["nodes"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/node" }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": ["name", "areaType"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "areaType": { "type": "string", "minLength": 1 },
        "areaTypeId": { "type": "string", "format": "uuid" },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/node" },
          "default": []
        }
      }
    }
  }
}

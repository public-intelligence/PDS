<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PDS.Domain\PDS.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Managers\" />
    <Folder Include="Migrations\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Semilla territorial de la República Dominicana ejecutada por la migración SeedTerritorioRD. -->
    <EmbeddedResource Include="Seed/TerritorioRD.sql" />
    <!-- Catálogo ISO 3166-1 de países ejecutado por la migración AddPaisCodigoIso3. -->
    <EmbeddedResource Include="Seed/PaisesIso3166.sql" />
    <!-- Carga inicial del calendario laboral (SPEC-LOC-CAL-01 §13.1) ejecutada por la migración SeedCalendarioLaboralInicial. -->
    <EmbeddedResource Include="Seed/CalendarioLaboralInicial.sql" />
    <!-- Funciones de localidad (RF-LO-45) sembradas por la migración AddFuncionesLocalidad. -->
    <EmbeddedResource Include="Seed/FuncionesLocalidad.sql" />
  </ItemGroup>

</Project>
